# Database configuration (PostgreSQL + PostGIS via Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=naija_pulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/naija_pulse

# FastAPI Application Settings
ENVIRONMENT=development
LIVE_MODE=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# H3 Spatial Resolution Configurations
# Res 7: ~1.2km edge (Macro/LGA density)
# Res 8: ~460m edge (Micro-neighborhood dedup & community verification)
# Res 9: ~174m edge (Street/Junction level)
H3_CLUSTER_RESOLUTION=8
H3_AGGREGATE_RESOLUTION=7

# Cloudinary (Optional - for citizen photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
